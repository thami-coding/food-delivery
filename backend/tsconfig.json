{
 "compilerOptions": {
  "module": "nodenext",
  "types": [
   "node",
   "jest"
  ],
  "outDir": "./dist",
  "rootDir": "./src",
  "moduleResolution": "nodenext",
  "pretty": true,
  "sourceMap": false,
  "target": "ESNext",
  "noImplicitAny": false,
  "esModuleInterop": true,
  "removeComments": true,
  "preserveConstEnums": true,
  "experimentalDecorators": true,
  "alwaysStrict": true,
  "forceConsistentCasingInFileNames": true,
  "emitDecoratorMetadata": true,
  "resolveJsonModule": true,
  "skipLibCheck": true
 },
 "include": [
  "src/**/*"
 ],
 "exclude": [
  "node_modules"
 ]
}